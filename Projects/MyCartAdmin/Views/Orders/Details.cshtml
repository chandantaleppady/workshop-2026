@model MyCartAdmin.Models.OrderDetail
@{
    ViewData["Title"] = "Order details";
}

<a asp-action="Index" class="mb-7 inline-flex items-center gap-2 text-xs font-semibold text-brand-600 no-underline hover:text-brand-700"><span aria-hidden="true">←</span> All orders</a>
@{
    var statusClasses = Model.DispatchStatus switch
    {
        "Sent" => "bg-emerald-100 text-emerald-800",
        "Sending" => "bg-amber-100 text-amber-800",
        "Failed" => "bg-red-100 text-red-800",
        _ => "bg-gray-100 text-gray-700"
    };
}
<section class="mb-7 flex items-center justify-between gap-6">
    <div><p class="mb-2 font-mono text-[10px] font-medium tracking-[1.2px] text-brand-600">ORDER DETAIL</p><h1 class="mb-2 text-2xl font-semibold">Order <span class="font-mono text-sm font-normal text-[#68736e]">@Model.OrderId.ToString("N")[..12]</span></h1><p class="mb-0 text-sm text-[#68736e]">Placed @Model.OrderDateUtc.ToLocalTime().ToString("MMMM d, yyyy 'at' h:mm tt")</p></div>
    <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-[11px] font-semibold @statusClasses"><span class="size-1.5 rounded-full bg-current"></span>@Model.DispatchStatus</span>
</section>
@if (TempData["Success"] is string success)
{
    <div class="mb-4 rounded border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900" role="status">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="mb-4 rounded border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">@error</div>
}

<div class="grid items-start gap-5 lg:grid-cols-[minmax(0,1fr)_300px]">
    <section class="min-w-0">
        <div class="mb-3 flex items-end justify-between"><div><p class="mb-1 font-mono text-[10px] font-medium tracking-[1.2px] text-brand-600">PICK LIST</p><h2 class="text-lg font-semibold">Order items</h2></div><span class="text-xs text-[#68736e]">@Model.ItemCount units</span></div>
        <div class="overflow-hidden rounded-md border border-[#e0e6e2] bg-white"><div class="overflow-x-auto"><table class="w-full min-w-[600px] border-collapse text-sm">
            <thead class="bg-[#f8faf8] text-left font-mono text-[10px] font-medium tracking-wide text-[#748078]"><tr><th class="h-11 px-4">Product</th><th class="h-11 px-4 text-right">Unit price</th><th class="h-11 px-4 text-right">Qty</th><th class="h-11 px-4 text-right">Line total</th></tr></thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr><td class="border-t border-[#edf0ed] px-4 py-3"><span class="block font-medium">@item.ProductName</span><span class="mt-1 block text-xs text-[#68736e]">SKU @item.ProductId</span></td><td class="border-t border-[#edf0ed] px-4 py-3 text-right tabular-nums">₹@item.UnitPrice.ToString("N2")</td><td class="border-t border-[#edf0ed] px-4 py-3 text-right tabular-nums">@item.Quantity</td><td class="border-t border-[#edf0ed] px-4 py-3 text-right tabular-nums">₹@item.LineTotal.ToString("N2")</td></tr>
                }
            </tbody>
            <tfoot class="border-t border-[#e0e6e2] bg-[#fbfcfb]"><tr><th class="px-4 py-4 text-left font-semibold" colspan="3">Order total</th><th class="px-4 py-4 text-right font-semibold tabular-nums">₹@Model.OrderTotal.ToString("N2")</th></tr></tfoot>
        </table></div></div>
    </section>

    <aside class="rounded-md border border-[#e0e6e2] border-t-[3px] border-t-brand-600 bg-white p-5 max-lg:order-first"><p class="mb-2 font-mono text-[10px] font-medium tracking-[1.2px] text-brand-600">WAREHOUSE</p><h2 class="mb-2 text-lg font-semibold">Dispatch</h2>
        @if (Model.DispatchStatus == "Sent")
        {
            <p class="mb-4 text-sm text-[#68736e]">Sent @Model.SentToWarehouseAtUtc?.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</p>
            <a class="inline-flex min-h-10 w-full items-center justify-center rounded bg-brand-600 px-4 text-xs font-semibold text-white no-underline hover:bg-brand-700" asp-action="Download" asp-route-id="@Model.OrderId">Download JSON</a>
            <p class="mt-3 break-all font-mono text-[10px] text-[#68736e]">@Model.WarehouseBlobName</p>
        }
        else if (Model.DispatchStatus == "Sending")
        {
            <p class="mb-4 text-sm leading-relaxed text-[#68736e]">This order is currently being sent.</p>
            <button class="inline-flex min-h-10 w-full items-center justify-center rounded bg-gray-200 px-4 text-xs font-semibold text-gray-600" type="button" disabled>Sending...</button>
        }
        else
        {
            <p class="mb-4 text-sm leading-relaxed text-[#68736e]">Send the saved order details to the warehouse as a JSON document.</p>
            <form asp-action="SendToWarehouse" method="post" onsubmit="return confirm('Send this order to the warehouse?')">
                <input type="hidden" name="id" value="@Model.OrderId" />
                <button class="inline-flex min-h-10 w-full items-center justify-center rounded bg-brand-600 px-4 text-xs font-semibold text-white hover:bg-brand-700" type="submit">@(Model.DispatchStatus == "Failed" ? "Retry dispatch" : "Send to warehouse")</button>
            </form>
            @if (Model.DispatchStatus == "Failed" && !string.IsNullOrWhiteSpace(Model.LastDispatchError))
            {
                <p class="mt-3 text-xs text-red-700">@Model.LastDispatchError</p>
            }
        }
        <div class="mt-5 grid gap-1 border-t border-[#e0e6e2] pt-4 text-xs"><strong class="font-semibold">Payload</strong><span class="text-[#68736e]">@Model.Items.Count line items · @Model.ItemCount units</span></div>
    </aside>
</div>
