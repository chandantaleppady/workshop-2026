@model MyCartAdmin.Models.OrderListViewModel
@{
    ViewData["Title"] = "Orders";
    var lastPage = Math.Max(Model.PageCount, 1);
}

<section class="mb-7 flex items-end justify-between gap-6">
    <div>
        <p class="mb-2 font-mono text-[10px] font-medium tracking-[1.2px] text-brand-600">FULFILLMENT OPERATIONS</p>
        <h1 class="mb-2 text-3xl font-semibold tracking-normal">Orders</h1>
        <p class="mb-0 text-sm text-[#68736e]">Review customer orders and coordinate warehouse dispatch.</p>
    </div>
    <div class="flex flex-col items-end border-l border-[#e0e6e2] pl-5">
        <span class="font-mono text-2xl">@Model.TotalCount</span><span class="text-xs text-[#68736e]">orders found</span>
    </div>
</section>

@if (TempData["Success"] is string success)
{
    <div class="mb-4 rounded border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900" role="status">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="mb-4 rounded border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">@error</div>
}
<div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-800"></div>

<form method="get" class="mb-4 flex flex-wrap items-end gap-3 rounded-md border border-[#e0e6e2] bg-white p-4">
    <label class="grid min-w-[200px] flex-1 gap-1 text-xs font-semibold text-[#68736e]"><span>Order ID</span><input class="h-[38px] rounded border border-[#d8dfda] px-3 text-sm text-[#202824] focus:border-brand-600 focus:outline-none focus:ring-1 focus:ring-brand-600" type="search" name="search" value="@Model.Search" placeholder="Paste an order ID" /></label>
    <label class="grid min-w-[130px] gap-1 text-xs font-semibold text-[#68736e]"><span>Status</span>
        <select class="h-[38px] rounded border border-[#d8dfda] bg-white px-3 text-sm text-[#202824] focus:border-brand-600 focus:outline-none focus:ring-1 focus:ring-brand-600" name="status">
            <option value="">All statuses</option>
            @foreach (var status in new[] { "Pending", "Sending", "Sent", "Failed" })
            {
                <option value="@status" selected="@(Model.Status == status)">@status</option>
            }
        </select>
    </label>
    <label class="grid min-w-[130px] gap-1 text-xs font-semibold text-[#68736e]"><span>From</span><input class="h-[38px] rounded border border-[#d8dfda] px-2 text-sm text-[#202824]" type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" /></label>
    <label class="grid min-w-[130px] gap-1 text-xs font-semibold text-[#68736e]"><span>To</span><input class="h-[38px] rounded border border-[#d8dfda] px-2 text-sm text-[#202824]" type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" /></label>
    <button type="submit" class="inline-flex h-[38px] items-center justify-center rounded bg-brand-600 px-4 text-xs font-semibold text-white transition hover:bg-brand-700">Filter</button>
    <a asp-action="Index" class="inline-flex h-[38px] items-center justify-center rounded border border-[#e0e6e2] bg-white px-4 text-xs font-semibold text-[#202824] no-underline hover:bg-[#f8faf8]">Clear</a>
</form>

<section class="overflow-hidden rounded-md border border-[#e0e6e2] bg-white" aria-label="Orders">
    @if (Model.Orders.Count == 0)
    {
        <div class="px-5 py-16 text-center"><span class="font-mono text-3xl text-[#9aa69e]">—</span><h2 class="mb-2 mt-3 text-lg font-semibold">No orders found</h2><p class="mb-0 text-sm text-[#68736e]">Try changing the filters or check the database connection.</p></div>
    }
    else
    {
        <div class="overflow-x-auto"><table class="w-full min-w-[700px] border-collapse text-sm">
            <thead class="bg-[#f8faf8] text-left font-mono text-[10px] font-medium tracking-wide text-[#748078]"><tr><th class="h-11 px-4">Order</th><th class="h-11 px-4">Placed</th><th class="h-11 px-4 text-right">Items</th><th class="h-11 px-4 text-right">Total</th><th class="h-11 px-4">Status</th><th class="h-11 px-4"><span class="sr-only">Actions</span></th></tr></thead>
            <tbody>
                @foreach (var order in Model.Orders)
                {
                    var statusClasses = order.DispatchStatus switch
                    {
                        "Sent" => "bg-emerald-100 text-emerald-800",
                        "Sending" => "bg-amber-100 text-amber-800",
                        "Failed" => "bg-red-100 text-red-800",
                        _ => "bg-gray-100 text-gray-700"
                    };
                    <tr>
                        <td class="border-t border-[#edf0ed] px-4 py-4"><a class="font-mono text-xs font-medium text-[#202824] no-underline hover:text-brand-600 hover:underline" asp-action="Details" asp-route-id="@order.OrderId">@order.OrderId.ToString("N")[..12]</a></td>
                        <td class="border-t border-[#edf0ed] px-4 py-3"><span class="block font-medium">@order.OrderDateUtc.ToLocalTime().ToString("MMM d, yyyy")</span><span class="mt-1 block text-xs text-[#68736e]">@order.OrderDateUtc.ToLocalTime().ToString("h:mm tt")</span></td>
                        <td class="border-t border-[#edf0ed] px-4 py-4 text-right tabular-nums">@order.ItemCount</td>
                        <td class="border-t border-[#edf0ed] px-4 py-4 text-right tabular-nums">₹@order.OrderTotal.ToString("N2")</td>
                        <td class="border-t border-[#edf0ed] px-4 py-4"><span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-semibold @statusClasses"><span class="size-1.5 rounded-full bg-current"></span>@order.DispatchStatus</span></td>
                        <td class="border-t border-[#edf0ed] px-4 py-4 text-right"><a class="text-xs font-semibold text-brand-600 no-underline hover:text-brand-700" asp-action="Details" asp-route-id="@order.OrderId">View <span aria-hidden="true">→</span></a></td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
</section>

<nav class="flex items-center justify-between py-4 text-xs text-[#68736e]" aria-label="Order pages">
    <span>Page @Model.Page of @lastPage</span><div class="flex gap-2">
        @if (Model.Page > 1)
        {
            <a class="inline-flex h-9 items-center rounded border border-[#e0e6e2] bg-white px-3 text-xs font-semibold text-[#202824] no-underline hover:bg-[#f8faf8]" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-status="@Model.Status" asp-route-search="@Model.Search" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">Previous</a>
        }
        @if (Model.Page < lastPage)
        {
            <a class="inline-flex h-9 items-center rounded border border-[#e0e6e2] bg-white px-3 text-xs font-semibold text-[#202824] no-underline hover:bg-[#f8faf8]" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-status="@Model.Status" asp-route-search="@Model.Search" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">Next</a>
        }
    </div>
</nav>
