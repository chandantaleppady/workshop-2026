@model MyShoppingCart.Models.CartViewModel

<div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-200">
    <h2 class="text-xl font-bold tracking-tight">Your Cart</h2>
    <button type="button" id="cart-close" aria-label="Close cart"
            class="w-8 h-8 rounded-full text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition">✕</button>
</div>

@if (Model.Lines.Count == 0)
{
    <div class="text-center py-16">
        <div class="text-5xl mb-4">🛒</div>
        <p class="text-slate-400 text-lg">Your cart is empty</p>
        <p class="text-slate-400 text-sm mt-1">Add some fresh veggies to get started!</p>
    </div>
}
else
{
    <ul class="divide-y divide-slate-100">
        @foreach (var line in Model.Lines)
        {
            <li class="cart-line flex items-center gap-3 py-4" data-product-id="@line.Product.Id">
                <div class="rounded-lg overflow-hidden shrink-0">
                    <img class="w-14 h-14 object-cover" src="@line.Product.ImageUrl" alt="@line.Product.Name" />
                </div>
                <div class="flex-1 min-w-0">
                    <div class="font-semibold truncate">@line.Product.Name</div>
                    <div class="text-sm text-slate-500">
                        ₹@line.Product.Price.ToString("0") × @line.Quantity =
                        <span class="font-semibold text-slate-800">₹@line.LineTotal.ToString("0")</span>
                    </div>
                </div>
                <div class="inline-flex items-center gap-2">
                    <button type="button" data-action="remove" aria-label="Remove one"
                            class="qty-btn qty-minus w-8 h-8 rounded-full border border-brand-600 text-brand-700 leading-none hover:bg-brand-600 hover:text-white transition">−</button>
                    <span class="qty-value min-w-[1.25rem] text-center font-bold tabular-nums">@line.Quantity</span>
                    <button type="button" data-action="add" aria-label="Add one"
                            class="qty-btn qty-plus w-8 h-8 rounded-full bg-brand-600 text-white leading-none shadow hover:bg-brand-700 active:scale-95 transition">+</button>
                </div>
            </li>
        }
    </ul>
    <div class="flex items-center justify-between pt-4 mt-4 border-t-2 border-slate-200 text-lg">
        <span class="text-slate-500">Total (@Model.TotalCount item@(Model.TotalCount == 1 ? "" : "s"))</span>
        <span class="text-2xl font-bold text-brand-700">₹@Model.GrandTotal.ToString("0")</span>
    </div>
}
